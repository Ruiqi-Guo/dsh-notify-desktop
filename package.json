{
  "name": "dsh-notify-desktop",
  "version": "0.1.0",
  "description": "DSH plugin: a loud, persistent orange card at the bottom-right when a session finishes — it names the session, never auto-dismisses, has a close button that does NOT jump, and clicking the card brings the browser forward and switches the GUI to that session.",
  "license": "MIT",
  "author": "Ruiqi Guo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ruiqi-Guo/dsh-notify-desktop.git"
  },
  "homepage": "https://github.com/Ruiqi-Guo/dsh-notify-desktop#readme",
  "bugs": {
    "url": "https://github.com/Ruiqi-Guo/dsh-notify-desktop/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "notification",
    "notify",
    "alert",
    "desktop",
    "toast",
    "windows"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "os": [
    "win32"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller"
      ]
    },
    "compatibility": {
      "dsh": "^0.1.5-rc.1 || ^0.1.5-rc.2"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-api-session-controller": "^0.1.5-rc.1 || ^0.1.5-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.5-rc.1 || ^0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.1 || ^0.1.5-rc.2",
    "@deepseek-ai/dsh-session-title": "^0.1.5-rc.1 || ^0.1.5-rc.2"
  }
}
